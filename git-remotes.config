# Versioned reference for this repository's intended Git remotes.
# The active local settings are stored separately in .git/config.

[remote "origin"]
	url = https://github.com/hmloc014/Tool_PSSE_source.git
	fetch = +refs/heads/*:refs/remotes/origin/*

[remote "reference"]
	url = https://github.com/thanhhang-9005/Tool_PSSE_V2.git
	fetch = +refs/heads/*:refs/remotes/reference/*
